rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended';
    }

    function isCircleMember(circleId) {
      return activeUser()
        && exists(/databases/$(database)/documents/circles/$(circleId))
        && get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'username', 'avatar', 'bio', 'vibe']));
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if activeUser();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'username', 'avatar', 'bio', 'vibe', 'lastSeenAt']));
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if activeUser() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if activeUser()
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if activeUser()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'lastMessage']);
      allow delete: if false;

      match /messages/{messageId} {
        function isChatMember() {
          return activeUser()
            && get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              .hasAny([request.auth.uid]);
        }
        allow read: if isChatMember();
        allow create: if isChatMember() && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatMember()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'options', 'totalVotes']);
        allow delete: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
        && request.resource.data.viewedBy.hasAny([request.auth.uid]);
      allow delete: if isAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid);
    }

    match /circles/{circleId} {
      allow read: if activeUser() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if activeUser()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.creatorId == request.auth.uid);
    }

    match /moments/{momentId} {
      allow read: if activeUser()
        && (!resource.data.keys().hasAny(['circleId'])
          || resource.data.circleId == null
          || isCircleMember(resource.data.circleId));
      allow create: if activeUser()
        && request.resource.data.authorId == request.auth.uid
        && (!request.resource.data.keys().hasAny(['circleId'])
          || request.resource.data.circleId == null
          || isCircleMember(request.resource.data.circleId));
      allow update, delete: if isAdmin()
        || (activeUser() && resource.data.authorId == request.auth.uid);
    }

    match /connections/{connectionId} {
      allow read: if activeUser()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || isAdmin());
      allow create: if activeUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if activeUser() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
